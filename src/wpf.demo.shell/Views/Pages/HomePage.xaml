<Page x:Class="WpfDemo.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:WpfDemo.Views.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent">
    <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,12,24,24">
            <Border Padding="0"
                    CornerRadius="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="{DynamicResource HeroGradientStartColor}" />
                        <GradientStop Offset="0.58" Color="{DynamicResource HeroGradientMiddleColor}" />
                        <GradientStop Offset="1" Color="{DynamicResource HeroGradientEndColor}" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid MinHeight="238" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Width="220"
                             Height="220"
                             Margin="-88,-112,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Fill="#14FFFFFF" />
                    <Ellipse Width="160"
                             Height="160"
                             Margin="0,-64,220,0"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Fill="#10FFFFFF" />
                    <Ellipse Width="124"
                             Height="124"
                             Margin="0,0,-48,18"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Fill="#12FFFFFF" />

                    <StackPanel Margin="32,28,24,28">
                        <Border Padding="12,5"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource HeroBadgeBackgroundBrush}"
                                BorderBrush="{DynamicResource HeroBadgeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon FontSize="14"
                                               Foreground="White"
                                               Symbol="Sparkle24" />
                                <TextBlock Margin="6,0,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="Dashboard / NavigationView" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,18,0,0"
                                   FontSize="48"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="欢迎使用 WPF Demo" />

                        <TextBlock Margin="0,8,0,0"
                                   MaxWidth="460"
                                   FontSize="25"
                                   Foreground="{DynamicResource HeroSubtitleBrush}"
                                   Text="Fluent UI 组件展示与导航系统" 
                                   TextWrapping="Wrap" />

                        <StackPanel Margin="0,28,0,0"
                                    Orientation="Horizontal">
                            <ui:Button Padding="22,12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource HeroPrimaryButtonForegroundBrush}"
                                       Background="{DynamicResource HeroPrimaryButtonBackgroundBrush}"
                                       BorderBrush="{DynamicResource HeroPrimaryButtonBackgroundBrush}"
                                       Click="HeroBrowseComponents_Click"
                                       Content="开始浏览组件"
                                       Icon="{ui:SymbolIcon Rocket24}" />
                            <ui:Button Margin="14,0,0,0"
                                       Padding="22,12"
                                       Appearance="Transparent"
                                       Foreground="White"
                                       Background="{DynamicResource HeroSecondaryButtonBackgroundBrush}"
                                       BorderBrush="{DynamicResource HeroSecondaryButtonBorderBrush}"
                                       BorderThickness="1"
                                       Click="HeroScrollToUpdates_Click"
                                       Content="查看更新日志"
                                       Icon="{ui:SymbolIcon DocumentBulletList24}" />
                        </StackPanel>
                    </StackPanel>

                    <Canvas Grid.Column="1"
                            Margin="28,24,28,24">
                        <Border Width="126"
                                Height="88"
                                Canvas.Left="148"
                                Canvas.Top="8"
                                Background="#34FFFFFF"
                                BorderBrush="#2EFFFFFF"
                                BorderThickness="1"
                                CornerRadius="18"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="-10" />
                                    <SkewTransform AngleX="-8" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ui:SymbolIcon HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="42"
                                           Foreground="#E8FFFFFF"
                                           Symbol="GridDots24" />
                        </Border>

                        <Border Width="132"
                                Height="88"
                                Canvas.Left="276"
                                Canvas.Top="18"
                                Background="#28FFFFFF"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"
                                CornerRadius="18"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="-8" />
                                    <SkewTransform AngleX="-8" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ui:SymbolIcon HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="42"
                                           Foreground="#E8FFFFFF"
                                           Symbol="TextFont24" />
                        </Border>

                        <Border Width="148"
                                Height="94"
                                Canvas.Left="108"
                                Canvas.Top="98"
                                Background="#18FFFFFF"
                                BorderBrush="#24FFFFFF"
                                BorderThickness="1"
                                CornerRadius="20"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="8" />
                                    <SkewTransform AngleX="-10" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ui:SymbolIcon HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="46"
                                           Foreground="#E8FFFFFF"
                                           Symbol="DataPie24" />
                        </Border>

                        <Border Width="144"
                                Height="96"
                                Canvas.Left="238"
                                Canvas.Top="108"
                                Background="#20FFFFFF"
                                BorderBrush="#24FFFFFF"
                                BorderThickness="1"
                                CornerRadius="20"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="-6" />
                                    <SkewTransform AngleX="-8" />
                                </TransformGroup>
                            </Border.RenderTransform>
                            <ui:SymbolIcon HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="46"
                                           Foreground="#E8FFFFFF"
                                           Symbol="Code24" />
                        </Border>
                    </Canvas>
                </Grid>
            </Border>

            <ItemsControl Margin="-9,18,-9,0" ItemsSource="{Binding QuickActions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:QuickActionCardControl Margin="9,0,9,0"
                                                         Loaded="QuickActionCard_Loaded" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ui:Card x:Name="VersionUpdatesCard" Margin="0,18,0,0" Padding="22">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Left"
                                    VerticalAlignment="Center">
                            <ui:SymbolIcon VerticalAlignment="Center"
                                           FontSize="18"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Symbol="DocumentBulletList24" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="版本更新" />
                        </StackPanel>

                        <ui:Button DockPanel.Dock="Right"
                                   Padding="12,8"
                                   Appearance="Secondary"
                                   Click="HeroScrollToUpdates_Click"
                                   Content="查看完整日志" />
                    </DockPanel>

                    <ItemsControl Margin="-9,20,-9,0" ItemsSource="{Binding ReleaseNotes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="9,0,9,0"
                                        Padding="16"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="14"
                                                     Height="14"
                                                     Fill="{Binding AccentColor}" />
                                            <Border Grid.Column="1"
                                                    Height="2"
                                                    Margin="12,6,0,0"
                                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   Margin="0,16,0,0"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Version}" />
                                        <TextBlock Grid.Row="2"
                                                   Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding DateLabel}" />
                                        <TextBlock Grid.Row="3"
                                                   Margin="0,10,12,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Summary}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <controls:InfoBannerControl Margin="0,18,0,0"
                                        DataContext="{Binding InfoBanner}" />
        </StackPanel>
    </ScrollViewer>
</Page>
