<ui:FluentWindow
    x:Class="WpfDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="WPF Demo"
    Width="1120"
    Height="760"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <ui:FluentWindow.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:TitleBarButton}}" TargetType="{x:Type ui:TitleBarButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="MainTitleBar"
            Grid.Row="0"
            Height="44">
            <ui:TitleBar.Header>
                <StackPanel
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="34"
                        Height="34"
                        Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                        CornerRadius="10">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="D" />
                    </Border>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="WPF Demo" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Navigation Shell" />
                    </StackPanel>
                </StackPanel>
            </ui:TitleBar.Header>

            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        x:Name="ThemeToggleButton"
                        Click="ToggleThemeMode"
                        Width="40"
                        Height="40"
                        Margin="0"
                        Padding="0"
                        Appearance="Transparent"
                        Foreground="{Binding Path=ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"
                        PressedForeground="{Binding Path=ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"
                        MouseOverBackground="{Binding Path=ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"
                        MouseOverBorderBrush="Transparent"
                        PressedBackground="{Binding Path=ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"
                        PressedBorderBrush="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        Focusable="False"
                        ToolTipService.ToolTip="切换到浅色模式">
                        <ui:SymbolIcon
                            x:Name="ThemeToggleIcon"
                            Symbol="WeatherSunny24" />
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:NavigationView
                x:Name="RootNavigation"
                Grid.Column="0"
                CompactPaneLength="48"
                OpenPaneLength="260"
                PaneDisplayMode="Left"
                PaneTitle="演示导航">
                <ui:NavigationView.PaneHeader>
                    <StackPanel Margin="16,12,16,8">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="工作区" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="Fluent 组件目录" />
                    </StackPanel>
                </ui:NavigationView.PaneHeader>
            </ui:NavigationView>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ui:BreadcrumbBar x:Name="RootBreadcrumb" Margin="24,16,24,8" />

                <Frame
                    x:Name="PageHost"
                    Grid.Row="1"
                    Margin="16,0,16,16"
                    NavigationUIVisibility="Hidden" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
