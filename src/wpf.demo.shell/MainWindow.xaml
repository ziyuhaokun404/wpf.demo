<ui:FluentWindow
    x:Class="WpfDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="WPF Demo"
    Width="1120"
    Height="760"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <Style BasedOn="{StaticResource {x:Type ui:TitleBarButton}}" TargetType="{x:Type ui:TitleBarButton}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource ShellWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="MainTitleBar"
            Grid.Row="0"
            Height="44">
            <ui:TitleBar.Header>
                <StackPanel
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="30"
                        Height="30"
                        Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                        CornerRadius="10">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="D" />
                    </Border>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="WPF Demo" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Navigation Shell" />
                    </StackPanel>
                </StackPanel>
            </ui:TitleBar.Header>

            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        x:Name="ThemeToggleButton"
                        Width="40"
                        Height="40"
                        Margin="0"
                        Padding="0"
                        Appearance="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        Click="ToggleThemeMode"
                        CornerRadius="0"
                        Focusable="False"
                        Foreground="{Binding Path=ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"
                        MouseOverBackground="{Binding Path=ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"
                        MouseOverBorderBrush="Transparent"
                        PressedBackground="{Binding Path=ButtonsBackground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"
                        PressedBorderBrush="Transparent"
                        PressedForeground="{Binding Path=ButtonsForeground, RelativeSource={RelativeSource AncestorType={x:Type ui:TitleBar}}}"
                        ToolTipService.ToolTip="切换到浅色模式">
                        <ui:SymbolIcon x:Name="ThemeToggleIcon" Symbol="WeatherSunny24" />
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="8,6,8,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:NavigationView
                x:Name="RootNavigation"
                Grid.Column="0"
                Margin="0,0,10,0"
                CompactPaneLength="48"
                IsBackButtonVisible="Collapsed"
                OpenPaneLength="280"
                PaneDisplayMode="Left"
                PaneTitle="">
                <ui:NavigationView.PaneHeader>
                    <StackPanel Margin="12,12,12,8">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="组件导航" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="使用 Wpf.Ui 默认导航样式和交互。" />
                    </StackPanel>
                </ui:NavigationView.PaneHeader>

                <ui:NavigationView.PaneFooter>
                    <StackPanel Margin="12,8,12,12">
                        <Separator />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="版本 1.0.0" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="12+ 演示入口" />
                    </StackPanel>
                </ui:NavigationView.PaneFooter>
            </ui:NavigationView>

            <Border
                Grid.Column="1"
                Background="{DynamicResource ShellSurfaceBrush}"
                BorderBrush="{DynamicResource ShellBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Padding="10"
                        BorderBrush="{DynamicResource ShellBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource ShellTextMutedBrush}"
                                    Text="CURRENT PAGE" />
                                <TextBlock
                                    x:Name="CurrentPageTitleText"
                                    Margin="0,8,0,0"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource ShellPrimaryTextBrush}"
                                    Text="主页" />
                                <ui:BreadcrumbBar
                                    x:Name="RootBreadcrumb"
                                    Height="0"
                                    Margin="0"
                                    Opacity="0"
                                    Visibility="Collapsed" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Border
                                    Width="384"
                                    Height="40"
                                    Background="{DynamicResource ShellOverlayBrush}"
                                    BorderBrush="{DynamicResource ShellBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Grid Margin="12,0,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:SymbolIcon
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource ShellTextMutedBrush}"
                                            Symbol="Search24" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource ShellTextMutedBrush}"
                                            Text="搜索组件、示例或文档..." />
                                        <Border
                                            Grid.Column="2"
                                            Padding="8,3"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource ShellSearchShortcutBackgroundBrush}"
                                            CornerRadius="8">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource ShellSearchShortcutForegroundBrush}"
                                                Text="Ctrl + K" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Grid Margin="16,0,0,0">
                                    <ui:Button
                                        Width="36"
                                        Height="36"
                                        Padding="0"
                                        Appearance="Transparent"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0">
                                        <ui:SymbolIcon Foreground="{DynamicResource ShellNotificationForegroundBrush}" Symbol="Alert24" />
                                    </ui:Button>
                                    <Border
                                        Width="16"
                                        Height="16"
                                        Margin="21,-2,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource ShellNotificationBadgeBrush}"
                                        CornerRadius="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="9"
                                            FontWeight="Bold"
                                            Foreground="White"
                                            Text="3" />
                                    </Border>
                                </Grid>

                                <Border
                                    Width="40"
                                    Height="40"
                                    Margin="14,0,0,0"
                                    Background="{DynamicResource ShellAvatarBackgroundBrush}"
                                    BorderBrush="{DynamicResource ShellAvatarBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20">
                                    <Grid>
                                        <Ellipse Margin="2" Fill="{DynamicResource ShellAvatarFillBrush}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource ShellAvatarForegroundBrush}"
                                            Text="ZH" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Frame
                        x:Name="PageHost"
                        Grid.Row="1"
                        Margin="8,10,8,8"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        NavigationUIVisibility="Hidden" />

                    <Border
                        Grid.Row="2"
                        Padding="18,12"
                        BorderBrush="{DynamicResource ShellBorderBrush}"
                        BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource ShellTextMutedBrush}"
                                Text=" " />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource ShellTextMutedBrush}"
                                    Symbol="CheckmarkCircle24" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource ShellTextMutedBrush}"
                                    Text="所有更改将自动保存" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
